# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=payflow
DATABASE_URL=postgres://payflow:changeme@localhost:5432/payflow?sslmode=disable

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=payflow
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://payflow:changeme@localhost:5672/

# ─── Payment Service (Go) ─────────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=8080
PAYMENT_SERVICE_ENV=development
LOG_LEVEL=debug

# ─── API Gateway (Node.js) ────────────────────────────────────────────────────
GATEWAY_PORT=3000
PAYMENT_SERVICE_URL=http://localhost:8080

# ─── Webhook ──────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=super-secret-webhook-key-change-me

# ─── Simulated Provider ───────────────────────────────────────────────────────
# Controls provider simulation behaviour: success | failure | pending | timeout
PROVIDER_DEFAULT_OUTCOME=success
PROVIDER_TIMEOUT_MS=3000
